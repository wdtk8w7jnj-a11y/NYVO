# Modèle de configuration du serveur pilote NYVO.
# Copier en .env (ignoré par Git) UNIQUEMENT sur une machine personnelle de confiance.
# Sur un hébergement, utiliser le gestionnaire de secrets de l’hébergeur à la place.
# Ne jamais committer de clé, ni la coller dans une conversation.

# Clé API-Football (api-sports.io), lue seulement par le serveur. Laisser vide ici.
API_FOOTBALL_KEY=

# Quota du plan (requêtes par jour, réinitialisé à 00:00 UTC) et budget utilisé par NYVO.
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_DAILY_BUDGET=90
API_FOOTBALL_PER_MINUTE=10

# Compétitions du pilote (identifiants API-Football). 61 = Ligue 1.
NYVO_PILOT_LEAGUES=61

# Vrais matchs : désactivés tant que cette valeur n’est pas 1 ET que les saisons
# n’ont pas été vérifiées par « npm run api:check -- --confirmer ».
NYVO_REAL_MATCHES=0
