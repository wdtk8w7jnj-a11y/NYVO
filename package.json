{
  "name": "nyvo-prototype",
  "version": "0.5.0",
  "private": true,
  "description": "NYVO — prototype interactif (données de démonstration)",
  "type": "module",
  "scripts": {
    "start:pilot": "node --env-file=.env scripts/serve.mjs app",
    "start": "node scripts/serve.mjs app",
    "serve:dist": "node scripts/serve.mjs dist",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:legacy": "cd reference/v0.2/03_PROTOTYPE && node tests/journey.cjs",
    "screenshots": "node scripts/screenshots.mjs",
    "compare": "node scripts/compare.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.10"
  }
}
